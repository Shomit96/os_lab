from queue import Queue

def pageFaults(pages, capacity):
    memory = set()         # To store current pages
    order = Queue()        # To keep track of the order (FIFO)
    faults = 0

    for page in pages:
        if page not in memory:
            if len(memory) == capacity:
                # Remove the oldest page
                old_page = order.get()
                memory.remove(old_page)

            # Add the new page
            memory.add(page)
            order.put(page)
            faults += 1

    return faults

# Example usage
pages = [1, 3, 0, 3, 5, 6, 3]
capacity = 3
print(pageFaults(pages, capacity))
